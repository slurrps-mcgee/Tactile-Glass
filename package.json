{
    "name": "tactileglass-css",
    "version": "0.2.0",
    "description": "A premium hybrid CSS framework uniting glassmorphism and tactile neumorphism.",
    "main": "dist/tactileglass.css",
    "style": "dist/tactileglass.css",
    "sass": "src/scss/tactileglass.scss",
    "homepage": "https://slurrps-mcgee.github.io/Tactile-Glass/",
    "repository": {
        "type": "git",
        "url": "git+https://github.com/slurrps-mcgee/Tactile-Glass.git"
    },
    "bugs": {
        "url": "https://github.com/slurrps-mcgee/Tactile-Glass/issues"
    },
    "directories": {
        "doc": "docs"
    },
    "files": [
        "dist",
        "src/scss"
    ],
    "scripts": {
        "sass:build": "sass src/scss/tactileglass.scss dist/tactileglass.css --no-source-map && cp dist/tactileglass.css docs/tactileglass.css",
        "sass:watch": "sass src/scss/tactileglass.scss docs/tactileglass.css --watch --no-source-map",
        "css:minify": "lightningcss --minify --bundle --targets \"> 0.25%\" dist/tactileglass.css -o dist/tactileglass.min.css",
        "build": "npm run sass:build && npm run css:minify",
        "serve": "vite --port 8080 --host 127.0.0.1 --open /",
        "dev": "npm run sass:build && concurrently -k \"npm run sass:watch\" \"npm run serve\""
    },
    "keywords": [
        "css",
        "framework",
        "glassmorphism",
        "neumorphism",
        "hybrid",
        "tactileglass"
    ],
    "author": "Kenneth Lamb",
    "license": "MIT",
    "devDependencies": {
        "concurrently": "^9.1.2",
        "lightningcss-cli": "^1.29.0",
        "sass": "^1.85.0",
        "vite": "^7.3.6"
    }
}
